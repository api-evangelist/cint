          "id": "7e2537dd-917f-4c79-a566-15c4a3c08b57",
          "name": "Suggests an optimal fielding time range for a locale",
          "request": {
            "name": "Suggests an optimal fielding time range for a locale",
            "description": {
              "content": "Suggests an optimal time range to field a target group in a specific locale, taking into account local holidays and respondent activity patterns.\n\nHow to specify a time range:\n\n* To get a suggestion for a specific duration starting from now, provide the `days` parameter.\n* To get a suggestion within a specific date window, provide both the `start` and `end` parameters.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "demand",
                "intelligent-calendar",
                "suggest-time-range"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "days",
                  "value": "<integer>",
                  "description": "The number of days to field the target group. Use this parameter OR both `start` and `end`."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "The start date for the fielding window (RFC3339 format). Use this parameter in conjunction with `end`, OR only use `days`."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "The end date for the fielding window (RFC3339 format). Use this parameter in conjunction with `start`, OR only use `days`."
                },
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "<string>",
                  "description": "Locale code."
                }
              ],
              "variable": []
            },
            "header": [
