          "name": "Suggest the required fielding time for a target group",
          "request": {
            "name": "Suggest the required fielding time for a target group",
            "description": {
              "content": "Suggests the optimal number of days required to field a target group based on its specifications. You can use this endpoint to estimate fielding time before creating a target group. You'll need to provide details like the locale, price, length of interview (LOI), incidence rate (IR), and desired number of completes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "demand",
                "intelligent-calendar",
                "suggest-days"
              ],
