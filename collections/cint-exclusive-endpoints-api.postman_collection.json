        {
          "id": "171af487-e68b-4509-8301-1672b06480fa",
          "name": "Generates a price prediction",
          "request": {
            "name": "Generates a price prediction",
            "description": {
              "content": "Predicts the cost per interview (CPI) for a potential target group using either a `rate_card` or `dynamic` pricing model. The model you choose must match the business unit's pricing configuration.\nPrivate Exchange required.\nThis endpoint is only available for accounts with a Private Exchange. If your account does not have this feature enabled, requests will fail with a 403 Forbiddenerror. Please contact your account manager if you need access to this functionality.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "demand",
                "accounts",
                ":account_id",
                "business-units",
                ":business_unit_id",
                "generate-price-prediction"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "account_id",
                  "description": "(Required) The account's unique identifier."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "business_unit_id",
                  "description": "(Required) The unique identifier for the business unit."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) This header is MANDATORY for all API requests. The API version format is `YYYY-MM-DD`.\n",
                "key": "Cint-API-Version",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"config\": {\n    \"type\": \"<string>\",\n    \"country_code\": \"<string>\",\n    \"expected_incidence_rate\": \"<float>\",\n    \"expected_length_of_interview_minutes\": \"<integer>\",\n    \"maximum_cpi\": {\n      \"value\": \"<string>\",\n      \"currency_code\": \"<string>\"\n    },\n    \"cpi_boost\": {\n      \"value\": \"<string>\",\n      \"currency_code\": \"<string>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "50b1baea-a7b4-4c8b-b3d6-66a80d783c07",
              "name": "The price prediction was generated successfully.",
