                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"config\": {\n    \"type\": \"rate_card\",\n    \"country_code\": \"US\",\n    \"expected_incidence_rate\": 0.25,\n    \"expected_length_of_interview_minutes\": 15,\n    \"maximum_cpi\": {\n      \"value\": \"10.00\",\n      \"currency_code\": \"USD\"\n    }\n  }\n}",
