        {
          "id": "0b27c22f-618e-4010-a9d6-5e52ffcafa52",
          "name": "Update a respondent's status",
          "request": {
            "name": "Update a respondent's status",
            "description": {
              "content": "Updates the respondent's status defined by the status code in the body of the request.\n\nThe following table contains the possible codes that can be supplied in the body's `status` field: \n\n| Cint Status Definition | S2S Code |\n| :---- | :---- |\n| Complete | **5** |\n| Screenout | **2** |\n| Quality Terminate | **4** |\n| Quota Full | **3** |\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fulfillment",
                "respondents",
                "transition"
              ],
              "host": [
                "{{fulfillment-respondents-transition-Url}}"
              ],
              "query": [],
              "variable": []
            },
