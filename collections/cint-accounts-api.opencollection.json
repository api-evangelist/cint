{
  "opencollection": "1.0.0",
  "info": {
    "name": "Demand Accounts API",
    "version": "2025-12-18"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cint.com/v1/accounts",
            "headers": [
              {
                "name": "Cint-API-Version",
                "value": ""
              }
            ]
          },
          "docs": "Retrieves a list of all accounts that the authenticated user is authorized to access. This list will be empty if you don't have access to any accounts."
        },
        {
          "info": {
            "name": "List all users for an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cint.com/v1/accounts/:account_id/users",
            "headers": [
              {
                "name": "Cint-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The account's unique identifier."
              },
              {
                "name": "user_type",
                "value": "",
                "type": "query",
                "description": "Filters users by user type. Currently, only 'project_manager' is supported."
              }
            ]
          },
          "docs": "Retrieves a list of all users who have access to a specific account. You can use the `user_type` query parameter to filter this list."
        },
        {
          "info": {
            "name": "List all service clients for an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cint.com/v1/accounts/:account_id/service-clients",
            "headers": [
              {
                "name": "Cint-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The account's unique identifier."
              },
              {
                "name": "user_type",
                "value": "",
                "type": "query",
                "description": "Filters users by user type. Currently, only 'project_manager' is supported."
              }
            ]
          },
          "docs": "Lists all available service clients for an account."
        },
        {
          "info": {
            "name": "Get default business unit assigned to user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cint.com/v1/accounts/:account_id/users/:user_id/business-units",
            "headers": [
              {
                "name": "Cint-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The account's unique identifier."
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "Uniquely identifies a user."
              }
            ]
          },
          "docs": "Returns the business unit ID associated with the specified user's account. \n\n:::info\nThis API doesn't return all the business units within an account. To get all the business units for an account use `/accounts/{account_id}/business-units`.\n:::\n"
        }
      ]
    }
  ],
  "bundled": true
}